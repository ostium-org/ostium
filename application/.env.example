# Stable hosted project URL; works on Expo Go, simulators and the browser.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable (or legacy anon) key only. NEVER put service-role/private signing keys here.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Explicit local demo only: leave SUPABASE_URL empty and set this true.
EXPO_PUBLIC_MOCK_API=false
