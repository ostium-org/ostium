# FastAPI address, not the Supabase project URL. Never put a secret key here.
# Browser / iOS simulator on the same computer:
EXPO_PUBLIC_API_URL=http://localhost:8000
# Physical phone: replace localhost with your computer's LAN IP.
# Android emulator: use http://10.0.2.2:8000.

# To intentionally use the local demo, leave API_URL empty and set this to true.
EXPO_PUBLIC_MOCK_API=false
