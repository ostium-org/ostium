@startuml firmware-class-diagram
!pragma layout smetana
' Door unit firmware classes (SCRUM-54), with QR access (SCRUM-38), and the
' camera scan source and access panel (SCRUM-68). Drawn by hand from the
' headers in hardware/esp32/lib/ostium_core/src/ and hardware/esp32/include/.
' To render: java -jar plantuml.jar -tsvg docs/firmware/diagrams/class-diagram.puml
' Run it again with -tpng for the report image. PlantUML uses only the last -t flag.

title Door unit firmware: class diagram (Assignment 1 MVP and QR access)

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam shadowing false
hide empty members

package "ostium_core: core logic (plain C++, no hardware)" as core {

  class LockController {
    + {static} kDefaultUnlockMs : uint32_t = 3000
    + {static} kMaxUnlockMs : uint32_t = 5000
    - unlockMs_ : uint32_t
    - unlocked_ : atomic<bool>
    - mutex_ : std::mutex
    + begin() : void
    + unlock() : bool
    + lock() : void
    + isUnlocked() : bool
    - {static} onRelockTimer(context : void*) : void
  }

  class CommandProcessor {
    + {static} kStartTimeMarginMs : int64_t = 2000
    + {static} kFallbackRetentionMs : int64_t = 10000
    - deviceId_ : string
    - startTimeMs_ : int64_t
    - hasStartTime_ : bool
    + handlePoll(poll : PollResult, requestStartedAtMs : uint32_t) : void
    + startTimeMs() : int64_t
    - handleCommand(command : ParsedCommand, nowEpochMs : int64_t, serverTimeMs : int64_t) : void
    - reject(command : ParsedCommand, reasonCode : string, nowEpochMs : int64_t) : void
    - report(command : ParsedCommand, result : Result, reasonCode : string, nowEpochMs : int64_t) : void
  }

  class DuplicateList {
    + {static} kCapacity : size_t = 32
    + contains(id : string) : bool
    + removeExpired(nowEpochMs : int64_t, nowMs : uint32_t = 0) : void
    + add(id : string, expiresAtEpochMs : int64_t, nowEpochMs : int64_t, nowMs : uint32_t = 0, holdMs : uint32_t = 0) : bool
    + size() : size_t
  }

  class EventOutbox {
    + {static} kCapacity : size_t = 8
    - kind_ : ReportKind
    + EventOutbox(log : Log, kind : ReportKind = Command)
    + push(event : Event, nowMs : uint32_t) : void
    + push(eventId : string, body : string, nowMs : uint32_t, droppable : bool) : bool
    + service(sender : EventSender, clock : Clock, retrying : bool* = nullptr) : bool
    + size() : size_t
    + contains(eventId : string) : bool
  }

  class "EventOutbox::Entry" as OutboxEntry <<struct>> {
    + eventId : string
    + body : string
    + nextAttemptMs : uint32_t
    + failures : uint32_t
    + droppable : bool
  }

  enum ReportKind {
    Command
    Qr
  }

  class ReportScheduler {
    - secondFirst_ : bool
    + ReportScheduler(first : EventOutbox, firstSender : EventSender, second : EventOutbox, secondSender : EventSender)
    + serviceOne(clock : Clock) : bool
  }

  class PollScheduler {
    + {static} kIntervalMs : uint32_t = 1500
    - nextDueMs_ : uint32_t
    - failures_ : uint32_t
    + due(nowMs : uint32_t) : bool
    + started(nowMs : uint32_t) : void
    + succeeded() : void
    + failed(nowMs : uint32_t) : void
  }

  class "poll_service.h" as PollService <<utility>> {
    + {static} runPoll(fetcher : PollFetcher, clock : Clock, scheduler : PollScheduler, processor : CommandProcessor, serverClock : ServerClock* = nullptr) : bool
  }

  class "poll_parser.h" as PollParser <<utility>> {
    + {static} parsePollResponse(status : int, body : string) : PollResult
  }

  class "body_reader.h" as BodyReader <<utility>> {
    + {static} readBody(source : ByteSource, clock : Clock, contentLength : int64_t, chunked : bool, limits : BodyLimits, out : string*) : BodyResult
  }

  class BodyLimits <<struct>> {
    + maxBytes : size_t
    + idleMs : uint32_t
    + totalMs : uint32_t
  }

  enum BodyResult {
    Complete
    TooLarge
    TimedOut
    Closed
    Malformed
  }

  class "timestamp.h" as Timestamp <<utility>> {
    + {static} parseTimestamp(text : string, epochMs : int64_t*) : bool
    + {static} formatTimestamp(epochMs : int64_t) : string
  }

  class "event.h" as EventFns <<utility>> {
    + {static} serializeEvent(event : Event) : string
    + {static} eventIdFor(commandId : string) : string
  }

  class PollResult <<struct>> {
    + ok : bool
    + error : string
    + serverTimeMs : int64_t
    + deferred : size_t
  }

  class ParsedCommand <<struct>> {
    + commandId : string
    + actionText : string
    + action : Action
    + doorId : string
    + issuedAtMs : int64_t
    + expiresAtMs : int64_t
    + problem : CommandProblem
  }

  class Event <<struct>> {
    + commandId : string
    + action : string
    + result : Result
    + reason : string
    + occurredAtMs : int64_t
    + eventId() : string
  }

  enum Action {
    None
    Lock
    Unlock
  }

  enum CommandProblem {
    None
    NoCommandId
    Malformed
    InvalidAction
  }

  enum Result {
    Done
    Rejected
  }
}

package "ostium_core: QR access (SCRUM-38)" as qr {

  class QrAccess {
    + {static} kMaxScanAgeMs : uint32_t = 2000
    + {static} kRepeatQuietMs : uint32_t = 3000
    + {static} kOccurredAtMarginMs : int64_t = 500
    + {static} kMaxLifetimeMs : int64_t = 60000
    + {static} kDenialMemoryMs : int64_t = 120000
    + {static} kListHoldMs : uint32_t = 61000
    - verify_ : Ed25519Verifier = verifyEd25519
    - enabled_ : bool
    - disabledReason_ : string
    - unitId_ : string
    - issuer_ : string
    - audience_ : string
    - lastText_ : string
    - lastSeenMs_ : uint32_t
    + begin(settings : QrSettings) : bool
    + enabled() : bool
    + handleScan(data : const char*, length : size_t, decodedAtMs : uint32_t) : QrDecision
    + handleScan(scan : QrScan) : QrDecision
    + revoke(credentialId : string, retainUntilEpochMs : int64_t, nowEpochMs : int64_t) : bool
    - evaluate(data : const char*, length : size_t, detail : const char**) : QrDecision
    - denyReported(claims : QrClaims, reason : const char*, occurredAtMs : int64_t, earliestMs : int64_t, nowMs : uint32_t) : QrDecision
    - logDecision(decision : QrDecision, detail : const char*, length : size_t) : void
  }

  class "qr_access.h" as QrAccessFns <<utility>> {
    + {static} drainScans(source : ScanSource, access : QrAccess, limit : size_t = 4, feedback : QrFeedback* = nullptr) : size_t
    + {static} qrSignalFor(decision : QrDecision) : QrSignal
  }

  enum QrSignal {
    None
    Granted
    Denied
    Wait
  }

  class "camera_scan.h" as CameraScanFns <<utility>> {
    + {static} scanFromCameraDecode(valid : bool, payload : const uint8_t*, length : int, capacity : size_t, decodedAtMs : uint32_t, scan : QrScan*) : bool
  }

  class QrSettings <<struct>> {
    + unitId : string
    + publicKey : string
    + keyId : string = "ostium-qr-1"
    + issuer : string = "ostium"
    + audience : string = "ostium-devices"
    + allowTestKey : bool = false
  }

  class QrDecision <<struct>> {
    + outcome : QrOutcome
    + reason : const char*
    + isFinal : bool
    + reported : bool
    + credentialId : string
  }

  enum QrOutcome {
    Granted
    Denied
    Ignored
  }

  class ServerClock {
    + {static} kDriftPpm : uint32_t = 50
    + {static} kMaxOfflineMs : uint32_t = 259200000
    + {static} kMaxWidthMs : int64_t = 30000
    + {static} kBootMarginMs : int64_t = 1000
    - anchorMs_ : uint32_t
    - lowMs_ : int64_t
    - highMs_ : int64_t
    - bootTimeLatestMs_ : int64_t
    - deviceRefused_ : bool
    + onPollSucceeded(serverTimeMs : int64_t, requestStartedMs : uint32_t, responseArrivedMs : uint32_t) : void
    + onPollRefused() : void
    + tick(nowMs : uint32_t) : void
    + bounds(nowMs : uint32_t, out : ServerTimeBounds*) : bool
    + bootTimeLatestMs() : int64_t
    + deviceRefused() : bool
    + {static} driftMs(elapsedMs : uint32_t) : int64_t
  }

  class ServerTimeBounds <<struct>> {
    + earliestMs : int64_t
    + latestMs : int64_t
  }

  class "qr_token.h" as QrTokenFns <<utility>> {
    + {static} verifyQrToken(text : const char*, length : size_t, key : QrKey, verify : Ed25519Verifier = verifyEd25519) : QrToken
    + {static} makeQrKey(keyId : string, publicKeyBase64Url : string, out : QrKey*, error : const char**) : bool
    + {static} canonicalUuid(text : string, lowercaseOut : string*) : bool
    + {static} issuedAtMsFromSeconds(seconds : double) : int64_t
    + {static} expiresAtMsFromSeconds(seconds : double) : int64_t
  }

  class QrKey <<struct>> {
    + keyId : string
    + publicKey : Ed25519PublicKey
    + expectedHeader : string
  }

  class QrToken <<struct>> {
    + problem : QrTokenProblem
    + detail : const char*
    + claims : QrClaims
  }

  class QrClaims <<struct>> {
    + credentialId : string
    + unitId : string
    + issuedAtMs : int64_t
    + expiresAtMs : int64_t
    + issuer : string
    + audience : string
    + hasIssuer : bool
    + hasAudience : bool
    + hasSubject : bool
    + hasOtherClaims : bool
  }

  enum QrTokenProblem {
    None
    Malformed
    UnsupportedHeader
    BadSignature
    MalformedClaims
  }

  class "base64url.h" as Base64Url <<utility>> {
    + {static} decodeBase64Url(text : const char*, length : size_t, out : string*) : bool
    + {static} encodeBase64Url(data : const uint8_t*, length : size_t) : string
  }

  class "ed25519.h" as Ed25519Fns <<utility>> {
    + {static} verifyEd25519(signature : const uint8_t[64], publicKey : Ed25519PublicKey, message : const uint8_t*, length : size_t) : bool
    + Ed25519Verifier : type, a pointer to a function like verifyEd25519
  }

  class "qr_self_test.h" as SelfTest <<utility>> {
    + {static} runQrSelfTest(token : const char*, publicKeyBase64Url : const char*, verify : Ed25519Verifier = verifyEd25519, clock : const Clock* = nullptr, checkMs : uint32_t* = nullptr) : bool
  }

  class "qr_event.h" as QrEventFns <<utility>> {
    + {static} serializeQrReport(report : QrReport) : string
    + {static} qrEventIdFor(credentialId : string, granted : bool) : string
  }

  class QrReport <<struct>> {
    + credentialId : string
    + granted : bool
    + reason : string
    + occurredAtMs : int64_t
    + eventId() : string
  }

  class SerialScanParser {
    + {static} kMaxLineBytes : size_t = 1024
    - line_ : string
    - overflow_ : bool
    - lastWasCr_ : bool
    + feed(c : char, token : string*, log : Log) : bool
  }
}

package "monocypher: vendored, unmodified 4.0.2" as vendored {
  class "monocypher-ed25519.h" as Monocypher <<utility>> {
    + {static} crypto_ed25519_check(signature : const uint8_t[64], publicKey : const uint8_t[32], message : const uint8_t*, length : size_t) : int
  }
}

package "ostium_core: interfaces to the hardware" as ports {

  interface LockOutput {
    + write(unlocked : bool) : void
  }

  interface OneShotTimer {
    + start(delayMs : uint32_t, callback, context) : bool
    + cancel() : void
  }

  interface Clock {
    + nowMs() : uint32_t
  }

  interface Log {
    + write(message : string) : void
  }

  interface PollFetcher {
    + get(body : string&) : int
  }

  interface EventSender {
    + post(body : string) : int
  }

  interface ByteSource {
    + available() : size_t
    + read() : int
    + connected() : bool
    + wait() : void
  }

  interface ScanSource {
    + next(scan : QrScan*) : bool
  }

  interface QrFeedback {
    + show(signal : QrSignal) : void
  }

  class QrScan <<struct>> {
    + text : string
    + decodedAtMs : uint32_t
  }
}

package "Board adapters (Arduino-ESP32, src/ and include/)" as board {

  class GpioLockOutput {
    - pin_ : uint8_t
    - activeHigh_ : bool
    + write(unlocked : bool) : void
  }

  class EspOneShotTimer {
    - handle_ : esp_timer_handle_t
    + begin() : bool
    + start(delayMs : uint32_t, callback, context) : bool
    + cancel() : void
  }

  class MillisClock {
    + nowMs() : uint32_t
  }

  class SerialLog {
    + write(message : string) : void
  }

  class ClientSource {
    - client_ : WiFiClient&
    + available() : size_t
    + read() : int
    + connected() : bool
    + wait() : void
  }

  class BackendClient {
    + {static} kTimeoutMs : uint32_t = 3000
    + {static} kBodyLimits : BodyLimits = 8 KiB, 3000, 6000
    - clock_ : MillisClock
    - commandsUrl_ : String
    - eventsUrl_ : String
    - qrEventsUrl_ : String
    - authorization_ : String
    + begin() : bool
    + get(body : string&) : int
    + post(body : string) : int
    + postQrEvent(body : string) : int
    + qrEvents() : EventSender&
  }

  class "BackendClient::QrEventSender" as QrEventSender {
    + post(body : string) : int
  }

  class SerialScanSource {
    - stream_ : Stream&
    + next(scan : QrScan*) : bool
  }

  class AccessPanel {
    + begin() : bool
    + update(nowMs : uint32_t) : void
    + show(signal : QrSignal) : void
    + telemetry() : PanelTelemetry
    + showMessage(line1 : const char*, line2 : const char*) : void
  }

  class PanelTelemetry <<struct>> {
    + temperature : float
    + humidity : float
    + soundRMS : float
  }

  class CameraScanSource {
    + next(scan : QrScan*) : bool
  }

  class WifiLink {
    - retryMs_ : uint32_t
    + begin() : void
    + maintain(nowMs : uint32_t) : void
    + connected() : bool
  }
}

' Core associations
CommandProcessor "1" --> "1" LockController : locks and unlocks >
CommandProcessor "1" --> "1" EventOutbox : queues events >
CommandProcessor "1" *-- "1" DuplicateList : handled IDs
CommandProcessor "1" --> "1" Clock
CommandProcessor "1" --> "1" Log
CommandProcessor ..> PollResult : reads
PollResult "1" *-- "0..32" ParsedCommand : commands
CommandProcessor ..> Event : creates
CommandProcessor ..> EventFns : eventIdFor()
EventOutbox "1" *-- "0..8" OutboxEntry : entries_
EventOutbox ..> EventFns : push() serializes with
EventFns ..> Event : reads
EventFns ..> Timestamp : formats occurred_at
EventOutbox ..> EventSender : posts with
EventOutbox "1" --> "1" Log
LockController "1" --> "1" LockOutput : drives >
LockController "1" --> "1" OneShotTimer : arms relock >
PollService ..> PollFetcher : fetches with
PollService ..> PollScheduler : updates
PollService ..> CommandProcessor : hands poll to
PollService ..> PollParser : parses with
PollParser ..> PollResult : creates
PollParser ..> Timestamp
EventOutbox --> ReportKind : kind_
ReportScheduler "1" --> "2" EventOutbox : one post per pass, QR first, taking turns >
ReportScheduler "1" --> "2" EventSender

' QR access associations
QrAccess "1" --> "1" LockController : unlocks >
QrAccess "1" --> "1" EventOutbox : queues QR reports >
QrAccess "1" --> "1" ServerClock : reads bounds
QrAccess "1" --> "1" Clock
QrAccess "1" --> "1" Log
QrAccess "1" *-- "3" DuplicateList : used_, revoked_, deniedReported_
QrAccess "1" *-- "1" QrKey : key_
QrAccess ..> QrSettings : begin() checks
QrAccess ..> SelfTest : begin() runs
QrAccess ..> QrTokenFns : verifyQrToken()
QrAccess ..> Ed25519Fns : verify_, for the self-test and every scan
QrAccess ..> QrDecision : returns
QrAccess ..> QrScan : handles
QrAccess ..> QrReport : creates
QrAccess ..> QrEventFns : serializes reports with
QrAccessFns ..> ScanSource : drains
QrAccessFns ..> QrAccess : handleScan()
QrAccessFns ..> QrFeedback : shows each signal, except None, with
QrAccessFns ..> QrSignal : qrSignalFor() returns
QrFeedback ..> QrSignal : shows
CameraScanFns ..> QrScan : fills
QrDecision --> QrOutcome
QrTokenFns ..> QrToken : creates
QrTokenFns ..> QrKey : makeQrKey() builds
QrToken "1" *-- "1" QrClaims
QrToken --> QrTokenProblem
QrTokenFns ..> Base64Url : decodes with
QrTokenFns ..> Ed25519Fns : checks the signature with
Ed25519Fns ..> Monocypher : crypto_ed25519_check()
SelfTest ..> QrTokenFns : verifyQrToken()
QrEventFns ..> QrReport : reads
QrEventFns ..> Timestamp : formats occurred_at
ServerClock ..> ServerTimeBounds : creates
ServerClock "1" --> "1" Log
PollService ..> ServerClock : feeds each poll to

' Realizations
GpioLockOutput ..|> LockOutput
EspOneShotTimer ..|> OneShotTimer
MillisClock ..|> Clock
SerialLog ..|> Log
BackendClient ..|> PollFetcher
BackendClient ..|> EventSender
QrEventSender ..|> EventSender
BackendClient "1" *-- "1" QrEventSender : qrEvents_
SerialScanSource ..|> ScanSource
SerialScanSource "1" *-- "1" SerialScanParser : parser_
SerialScanSource "1" --> "1" Log
CameraScanSource ..|> ScanSource
CameraScanSource ..> CameraScanFns : copies each camera decode with
CameraScanSource ..> AccessPanel : reads the camera queue that begin() starts
AccessPanel ..|> QrFeedback
AccessPanel ..> PanelTelemetry : telemetry() returns
ClientSource ..|> ByteSource
BackendClient ..> BodyReader : reads each response body with
BodyReader ..> ByteSource : reads from
WifiLink "1" --> "1" Log
BackendClient "1" --> "1" Log

legend right
  Assignment 1 classes, by the names in SCRUM-54:
  lock controller = LockController
  relay = LockOutput, GpioLockOutput
  command client = BackendClient (PollFetcher), runPoll() in poll_service.h,
    readBody() in body_reader.h (size cap and time limits)
  command validator = parsePollResponse() in poll_parser.h, CommandProcessor
  event reporter = EventOutbox (command and QR queues), EventSender,
    ReportScheduler
  clock = Clock, MillisClock, OneShotTimer, ServerClock
  Wi-Fi manager = WifiLink
  QR scanner = ScanSource, CameraScanSource with scanFromCameraDecode()
    in camera_scan.h (SCRUM-68), SerialScanSource (bench build),
    AccessPanel (runs the camera, and shows each decision as a QrFeedback)
  credential verifier = QrAccess, verifyQrToken() in qr_token.h,
    verifyEd25519() in ed25519.h, runQrSelfTest() in qr_self_test.h
  <<utility>> boxes are header files of free functions, not classes.
  main.cpp creates one LockController, CommandProcessor, PollScheduler,
  ServerClock, QrAccess, and ReportScheduler, two EventOutboxes (commands
  and QR reports), and one of each board adapter, and wires them together.
  Only the esp32s3-bench build creates a SerialScanSource.
endlegend

@enduml
