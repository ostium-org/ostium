@startuml firmware-use-case-diagram
!pragma layout smetana
' Door unit use cases (SCRUM-55). The MVP boundary is what Assignment 1
' demonstrates; the QR access boundary is what SCRUM-38 added.
' To render: java -jar plantuml.jar -tsvg docs/firmware/diagrams/use-case-diagram.puml
' Run it again with -tpng for the report image. PlantUML uses only the last -t flag.

title Door unit: use case diagram

left to right direction
skinparam packageStyle rectangle
skinparam shadowing false

actor "Property Manager" as Manager
actor "Tenant" as Tenant
actor "Guest" as Guest
actor "Smart Access Device\n(ESP32-S3 door unit)" as Device
actor "Backend API\n(Supabase Edge Functions)" as Backend <<system>>

rectangle "Assignment 1 MVP" {
  usecase "Lock door" as Lock
  usecase "Unlock door" as Unlock
  usecase "Receive command" as Receive
  usecase "Unlock for a set time\n(3 s, at most 5 s)" as Timed
  usecase "Relock" as Relock
  usecase "Report lock event" as Report
  usecase "Reject command\n(malformed, invalid action,\nwrong door, issued before boot,\nexpired, unlock failed,\nduplicate list full)" as Reject
}

rectangle "QR access (SCRUM-38)" {
  usecase "Present QR code" as Present
  usecase "Scan QR code" as Scan
  usecase "Verify credential" as Verify
  usecase "Report scan" as ReportScan
}

Manager --> Lock
Manager --> Unlock
Lock --> Backend
Unlock --> Backend

Device --> Receive
Device --> Timed
Device --> Relock
Device --> Report
Receive --> Backend
Report --> Backend

Unlock ..> Receive : <<include>>
Lock ..> Receive : <<include>>
Unlock ..> Timed : <<include>>
Lock ..> Relock : <<include>>
Timed ..> Relock : <<include>>
Receive ..> Report : <<include>>
Reject ..> Receive : <<extend>>

Tenant --> Present
Guest --> Present
Device --> Scan
Device --> Verify
Device --> ReportScan
ReportScan --> Backend
Present ..> Scan : <<include>>
Scan ..> Verify : <<include>>
ReportScan ..> Verify : <<extend>>
Timed ..> Verify : <<extend>>

note right of Scan
  The onboard camera decodes the code
  (SCRUM-68), and the panel's LCD shows
  each grant or denial. The bench build
  also reads decoded text from Serial.
end note

note right of Verify
  Signature, unit, server time bounds,
  single use, and expiry (Q1 to Q20).
  A valid credential runs the same
  timed unlock as an app command.
end note

note right of ReportScan
  Only for a token whose signature
  verified and whose unit matches,
  while the door knows the server
  time (Q8). Forged, malformed, and
  foreign tokens, and transient
  denials, are never reported.
end note

@enduml
