# Copy to `.env.local` and fill in. Values come from the Supabase project dashboard
# (Project Settings -> API).
#
# The backend only needs the URL + secret key for MVP (service role,
# which bypasses RLS). The publishable key is optional and only needed if we
# later switch the backend to make anon-scoped calls (more secure).

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your-service-role-secret-key
SUPABASE_PUBLISHABLE_KEY=

# Comma-separated list of allowed browser origins for CORS.
# Use "*" for local development.
CORS_ORIGINS=*

# Backend-only PEM PKCS8 Ed25519 private key. Literal \n escapes are accepted.
# Generate outside the repository; never use an EXPO_PUBLIC_ variable for this.
QR_SIGNING_PRIVATE_KEY=
QR_ISSUER=ostium
QR_AUDIENCE=ostium-devices
QR_KEY_ID=ostium-qr-1
